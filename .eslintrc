{
  "globals": {
    "abortNavigation": true,
    "addRouteMiddleware": true,
    "callOnce": true,
    "cancelIdleCallback": true,
    "clearError": true,
    "clearNuxtData": true,
    "clearNuxtState": true,
    "computed": true,
    "createError": true,
    "customRef": true,
    "defineAppConfig": true,
    "defineAsyncComponent": true,
    "defineComponent": true,
    "defineModel": true,
    "defineNuxtComponent": true,
    "defineNuxtLink": true,
    "defineNuxtPlugin": true,
    "defineNuxtRouteMiddleware": true,
    "defineOptions": true,
    "definePayloadPlugin": true,
    "definePayloadReducer": true,
    "definePayloadReviver": true,
    "definePageMeta": true,
    "useAuth": true,
    "defineSlots": true,
    "effect": true,
    "effectScope": true,
    "getAppManifest": true,
    "getCurrentInstance": true,
    "getCurrentScope": true,
    "getRouteRules": true,
    "h": true,
    "hasInjectionContext": true,
    "inject": true,
    "injectHead": true,
    "isNuxtError": true,
    "isPrerendered": true,
    "isProxy": true,
    "isReactive": true,
    "isReadonly": true,
    "isRef": true,
    "isShallow": true,
    "isVue2": true,
    "isVue3": true,
    "loadPayload": true,
    "markRaw": true,
    "mergeModels": true,
    "navigateTo": true,
    "nextTick": true,
    "onActivated": true,
    "onBeforeMount": true,
    "onBeforeRouteLeave": true,
    "onBeforeRouteUpdate": true,
    "onBeforeUnmount": true,
    "onBeforeUpdate": true,
    "onDeactivated": true,
    "onErrorCaptured": true,
    "onMounted": true,
    "onNuxtReady": true,
    "onRenderTracked": true,
    "onRenderTriggered": true,
    "onScopeDispose": true,
    "onServerPrefetch": true,
    "onUnmounted": true,
    "onUpdated": true,
    "prefetchComponents": true,
    "preloadComponents": true,
    "preloadPayload": true,
    "preloadRouteComponents": true,
    "prerenderRoutes": true,
    "provide": true,
    "proxyRefs": true,
    "reactive": true,
    "readonly": true,
    "ref": true,
    "refreshCookie": true,
    "refreshNuxtData": true,
    "reloadNuxtApp": true,
    "requestIdleCallback": true,
    "resolveComponent": true,
    "setInterval": true,
    "setPageLayout": true,
    "setResponseStatus": true,
    "shallowReactive": true,
    "shallowReadonly": true,
    "shallowRef": true,
    "showError": true,
    "toRaw": true,
    "toRef": true,
    "toRefs": true,
    "toValue": true,
    "triggerRef": true,
    "tryUseNuxtApp": true,
    "unref": true,
    "updateAppConfig": true,
    "useAppConfig": true,
    "useAsyncData": true,
    "useAttrs": true,
    "useCookie": true,
    "useCssModule": true,
    "useCssVars": true,
    "useError": true,
    "useFetch": true,
    "useHead": true,
    "useHeadSafe": true,
    "useHydration": true,
    "useId": true,
    "useLazyAsyncData": true,
    "useLazyFetch": true,
    "useLoadingIndicator": true,
    "useModel": true,
    "useNuxtApp": true,
    "useNuxtData": true,
    "useRequestEvent": true,
    "useRequestFetch": true,
    "useRequestHeader": true,
    "useRequestHeaders": true,
    "useRequestURL": true,
    "useRoute": true,
    "useRouter": true,
    "useRuntimeConfig": true,
    "useSeoMeta": true,
    "useServerHead": true,
    "useServerHeadSafe": true,
    "useServerSeoMeta": true,
    "useSlots": true,
    "useState": true,
    "useTransitionState": true,
    "watch": true,
    "watchEffect": true,
    "watchPostEffect": true,
    "watchSyncEffect": true,
    "withCtx": true,
    "withDirectives": true,
    "withKeys": true,
    "withMemo": true,
    "withModifiers": true,
    "withScopeId": true
  },
  "root": true,
  "env": {
    "browser": true,
    "node": true
  },
  "extends": [
    "plugin:prettier/recommended",
    "@nuxt/eslint-config",
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:nuxt/recommended"
  ],
  "plugins": [
    "@typescript-eslint"
  ],
  "rules": {
    "vue/singleline-html-element-content-newline": "off",
    "vue/multiline-html-element-content-newline": "off",
    "vue/max-attributes-per-line": "off",
    "no-undef": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.ts",
        "**/*.tsx"
      ],
      "extends": [
        "plugin:@typescript-eslint/eslint-recommended",
        "plugin:@typescript-eslint/recommended"
      ],
      "rules": {
        "@typescript-eslint/explicit-module-boundary-types": "off",
        "@typescript-eslint/ban-ts-comment": "off",
        "@typescript-eslint/no-explicit-any": "off"
      }
    }
  ],
  "parser": "vue-eslint-parser",
  "parserOptions": {
    "parser": "@typescript-eslint/parser"
  }
}